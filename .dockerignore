# Keep the build context small; the SPA and binary are built inside the image.
.git
.gitignore
.github
build/
working/
.agents/
agents/
docs/
e2e/
testdata/
examples/
**/node_modules
internal/web/dist/*
!internal/web/dist/.gitkeep
web/dist
*.md
.env
*.env
*.key
*.pem
*.crt
.vscode/
.idea/
.claude/
.codex/
.cursor/
.cache/
coverage/
*.log
*.test
*.out
Dockerfile
compose.yaml
.dockerignore
