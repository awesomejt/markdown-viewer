# Generic Docker Compose stack unit: one instance per directory in /opt/stacks.
#   systemctl enable --now docker-compose@<name>   # /opt/stacks/<name>/compose.yaml
#   systemctl reload docker-compose@<name>         # rebuild/pull and apply changes
[Unit]
Description=Docker Compose stack %i
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target
ConditionPathExists=/opt/stacks/%i/compose.yaml

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/opt/stacks/%i
ExecStart=/usr/bin/docker compose up -d --remove-orphans --wait --wait-timeout 120
ExecReload=/usr/bin/docker compose up -d --build --remove-orphans --wait --wait-timeout 120
ExecStop=/usr/bin/docker compose down
TimeoutStartSec=900
TimeoutStopSec=120

[Install]
WantedBy=multi-user.target
